# Приложение — окружение, ключ и адрес
# Пустой список ограничивает production dashboard значением ADMIN_EMAIL.

# Приложение — окружение, ключ и адрес
APP_NAME=Poster
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8088
APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

# Авторизация и администратор
ADMIN_EMAIL=
ADMIN_PASSWORD=

# База данных
DB_CONNECTION=pgsql
DB_HOST=db
DB_PORT=5432
DB_DATABASE=poster
DB_USERNAME=poster
DB_PASSWORD=local-poster

# Redis
REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PORT=6379

# Кеширование
CACHE_STORE=redis

# Сессии
SESSION_DRIVER=redis

# Очереди и Horizon
HORIZON_ALLOWED_EMAILS=
HORIZON_MAX_PROCESSES=1
QUEUE_CONNECTION=redis

# Логи
LOG_CHANNEL=stack
LOG_LEVEL=debug

# Файлы и облачное хранилище
FILESYSTEM_DISK=public

# Почта
MAIL_MAILER=log
MAIL_FROM_ADDRESS=hello@example.com
MAIL_FROM_NAME=Poster

# OpenAI
OPENAI_API_KEY=

# Hailuo
HAILUO_API_KEY=
HAILUO_GROUP_ID=

# Runway
RUNWAY_API_KEY=

# Suno
SUNO_UNOFFICIAL_API_KEY=
SUNO_UNOFFICIAL_API_URL=https://apibox.erweima.ai/api/v1

# YouTube
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=

# Instagram
INSTAGRAM_CLIENT_ID=
INSTAGRAM_CLIENT_SECRET=
INSTAGRAM_TOKEN=

# TikTok
TIKTOK_CLIENT_ID=
TIKTOK_CLIENT_SECRET=

# Telegram
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Frontend / Vite
VITE_APP_NAME=Poster

# Дополнительные параметры
FFMPEG_THREADS=1
