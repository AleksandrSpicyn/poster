# Приложение — окружение, ключ и адрес
# Пустой список ограничивает production dashboard значением ADMIN_EMAIL.

# Приложение — окружение, ключ и адрес
APP_NAME=Poster
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8088
APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

# Авторизация и администратор
ADMIN_EMAIL=
ADMIN_PASSWORD=

# База данных
DB_CONNECTION=pgsql
DB_HOST=db
DB_PORT=5432
DB_DATABASE=poster
DB_USERNAME=poster
DB_PASSWORD=local-poster

# Redis
REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PORT=6379

# Кеширование
CACHE_STORE=redis

# Сессии
SESSION_DRIVER=redis

# Очереди и Horizon
HORIZON_ALLOWED_EMAILS=
HORIZON_MAX_PROCESSES=1
QUEUE_CONNECTION=redis

# Логи
LOG_CHANNEL=stack
LOG_LEVEL=debug

# Файлы и облачное хранилище
FILESYSTEM_DISK=public

# Почта
MAIL_MAILER=log
MAIL_FROM_ADDRESS=hello@example.com
MAIL_FROM_NAME=Poster

# OpenAI — только для явно выбранных API-адаптеров, конвейер использует Codex
OPENAI_API_KEY=

# Codex — отдельный вход ChatGPT, данные сохраняются в storage
CODEX_BINARY=/usr/local/bin/codex
CODEX_MODEL=gpt-6.1-sol
CODEX_TIMEOUT=300
# CODEX_HOME по умолчанию: /var/www/storage/app/private/codex

# Видео: hailuo, runway или seedance
VIDEO_GENERATOR=hailuo
VIDEO_FALLBACK_GENERATOR=runway

# BytePlus ModelArk — Seedance со встроенным звуком
SEEDANCE_API_KEY=
SEEDANCE_API_URL=https://ark.ap-southeast.bytepluses.com/api/v3
SEEDANCE_MODEL=dreamina-seedance-2-5-flash-261115
SEEDANCE_RESOLUTION=720p

# Hailuo
HAILUO_API_KEY=
HAILUO_GROUP_ID=

# Runway
RUNWAY_API_KEY=

# Suno
SUNO_UNOFFICIAL_API_KEY=
SUNO_UNOFFICIAL_API_URL=https://apibox.erweima.ai/api/v1

# YouTube
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=

# Instagram
INSTAGRAM_CLIENT_ID=
INSTAGRAM_CLIENT_SECRET=
INSTAGRAM_TOKEN=

# TikTok
TIKTOK_CLIENT_ID=
TIKTOK_CLIENT_SECRET=

# Telegram
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Frontend / Vite
VITE_APP_NAME=Poster

# Дополнительные параметры
FFMPEG_THREADS=1
