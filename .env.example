# Приложение — окружение, ключ и адрес
# Пустой список ограничивает production dashboard значением ADMIN_EMAIL.

# Приложение — окружение, ключ и адрес
APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost
APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US
APP_MAINTENANCE_DRIVER=file

# Авторизация и администратор
BCRYPT_ROUNDS=12
ADMIN_EMAIL=
ADMIN_PASSWORD=

# База данных
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3308
DB_DATABASE=poster
DB_USERNAME=poster
DB_PASSWORD=local-poster

# Redis
REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# Кеширование
CACHE_STORE=database
MEMCACHED_HOST=127.0.0.1

# Сессии
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

# Очереди и Horizon
HORIZON_ALLOWED_EMAILS=
HORIZON_MAX_PROCESSES=1
QUEUE_CONNECTION=database
DB_QUEUE_RETRY_AFTER=3720

# Логи
LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# Файлы и облачное хранилище
FILESYSTEM_DISK=local
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

# Почта
MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# OpenAI — только для явно выбранных API-адаптеров, конвейер использует Codex
OPENAI_API_KEY=
OPENAI_ORGANIZATION=

# Codex — отдельный вход ChatGPT для этой установки, не API-ключ
CODEX_BINARY=/usr/local/bin/codex
CODEX_MODEL=gpt-6.1-sol
CODEX_TIMEOUT=300
# CODEX_HOME по умолчанию: storage/app/private/codex внутри текущего приложения

# Видео: hailuo, runway или seedance; резерв выбирается только при отказе запуска
VIDEO_GENERATOR=seedance
VIDEO_FALLBACK_GENERATOR=runway

# BytePlus ModelArk — Seedance со встроенным звуком
SEEDANCE_API_KEY=
SEEDANCE_API_URL=https://ark.ap-southeast.bytepluses.com/api/v3
SEEDANCE_MODEL=dreamina-seedance-2-0-mini-260615
SEEDANCE_RESOLUTION=720p

# Hailuo
HAILUO_API_KEY=
HAILUO_GROUP_ID=

# Runway
RUNWAY_API_KEY=

# Suno
SUNO_UNOFFICIAL_API_KEY=
SUNO_UNOFFICIAL_API_URL=https://apibox.erweima.ai/api/v1

# YouTube
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=

# Instagram
INSTAGRAM_CLIENT_ID=
INSTAGRAM_CLIENT_SECRET=
INSTAGRAM_TOKEN=

# TikTok
TIKTOK_CLIENT_ID=
TIKTOK_CLIENT_SECRET=
TIKTOK_DIRECT_POST=false
TIKTOK_PUBLIC_DIRECT_POST=false

# Telegram
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Frontend / Vite
VITE_APP_NAME="${APP_NAME}"

# Broadcasting
BROADCAST_CONNECTION=log
REVERB_APP_ID=poster
REVERB_APP_KEY=
REVERB_APP_SECRET=
REVERB_HOST=127.0.0.1
REVERB_PORT=8080
REVERB_SCHEME=http
REVERB_ALLOWED_ORIGINS=localhost,127.0.0.1

# Новые выпуски по расписанию пока выключены
CONTENT_SCHEDULE_ENABLED=false
CONTENT_SCHEDULE_CRON="0 9 * * *"
CONTENT_SCHEDULE_TIMEZONE=Asia/Bangkok
EPISODE_RELEASE_CRON="0 19 * * 0,2,5"
EPISODE_RELEASE_TIMEZONE=Europe/Moscow
EPISODE_RELEASE_WINDOW_MINUTES=30

# Дополнительные параметры
PHP_CLI_SERVER_WORKERS=4
FFMPEG_THREADS=1

YOUTUBE_DATA_API_KEY=
OPUS_CLIP_API_KEY=
