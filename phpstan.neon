includes:
    - vendor/larastan/larastan/extension.neon
    - vendor/nesbot/carbon/extension.neon
    - vendor/pestphp/pest/extension.neon

parameters:
    level: max
    paths:
        - app
        - bootstrap/app.php
        - config
        - database
        - routes
        - tests
    tmpDir: storage/phpstan
    parallel:
        maximumNumberOfProcesses: 2
