{
    "$schema": "https://getcomposer.org/schema.json",
    "name": "aleksandrspicyn/poster",
    "type": "project",
    "description": "AI short-video generation and publishing with a Laravel and Inertia dashboard.",
    "keywords": [
        "laravel",
        "framework"
    ],
    "license": "MIT",
    "require": {
        "php": "^8.4",
        "aleksandrspicyn/scribe-mcp": "^1.0",
        "google/apiclient": "^2.18",
        "inertiajs/inertia-laravel": "^3.7",
        "knuckleswtf/scribe": "^5.11",
        "laravel-notification-channels/telegram": "^8.0",
        "laravel/framework": "^13.42",
        "laravel/horizon": "^5.51",
        "laravel/tinker": "^3.1",
        "opcodesio/log-viewer": "^3.17",
        "openai-php/laravel": "^0.22",
        "pbmedia/laravel-ffmpeg": "^8.7",
        "spatie/laravel-data": "^4.15",
        "spatie/laravel-medialibrary": "^11.12",
        "spatie/laravel-settings": "^3.4",
        "tightenco/ziggy": "^2.4",
        "ext-pdo": "*"
    },
    "require-dev": {
        "barryvdh/laravel-ide-helper": "^3.5",
        "fakerphp/faker": "^1.23",
        "larastan/larastan": "^3.15",
        "laravel/boost": "^2.10",
        "laravel/pail": "^1.2.2",
        "laravel/pint": "^1.18",
        "laravel/sail": "^1.41",
        "mockery/mockery": "^1.6",
        "nunomaduro/collision": "^8.6",
        "pestphp/pest": "^5.3",
        "pestphp/pest-plugin-laravel": "^5.0",
        "phpunit/phpunit": "^13.4",
        "rector/rector": "^2.8",
        "roave/security-advisories": "dev-latest"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/",
            "Database\\Factories\\": "database/factories/",
            "Database\\Seeders\\": "database/seeders/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "scripts": {
        "pre-autoload-dump": "Google\\Task\\Composer::cleanup",
        "post-autoload-dump": [
            "Illuminate\\Foundation\\ComposerScripts::postAutoloadDump",
            "@php artisan package:discover --ansi"
        ],
        "post-update-cmd": [
            "@php artisan vendor:publish --tag=laravel-assets --ansi --force"
        ],
        "post-root-package-install": [
            "@php -r \"file_exists('.env') || copy('.env.example', '.env');\""
        ],
        "post-create-project-cmd": [
            "@php artisan key:generate --ansi",
            "@php -r \"file_exists('database/database.sqlite') || touch('database/database.sqlite');\"",
            "@php artisan migrate --graceful --ansi"
        ],
        "dev": [
            "Composer\\Config::disableProcessTimeout",
            "npx concurrently -c \"#93c5fd,#c4b5fd,#fb7185,#fdba74\" \"php artisan serve\" \"php artisan queue:listen --tries=1\" \"php artisan pail --timeout=0\" \"npm run dev\" --names=server,queue,logs,vite"
        ],
        "dev:ssr": [
            "npm run build:ssr",
            "Composer\\Config::disableProcessTimeout",
            "npx concurrently -c \"#93c5fd,#c4b5fd,#fb7185,#fdba74\" \"php artisan serve\" \"php artisan queue:listen --tries=1\" \"php artisan pail --timeout=0\" \"php artisan inertia:start-ssr\" --names=server,queue,logs,ssr"
        ],
        "test": [
            "@php artisan config:clear --ansi",
            "@php artisan test"
        ]
    },
    "extra": {
        "laravel": {
            "dont-discover": [],
            "providers": [
                "ProtoneMedia\\LaravelFFMpeg\\Support\\ServiceProvider"
            ],
            "aliases": {
                "FFMpeg": "ProtoneMedia\\LaravelFFMpeg\\Support\\ServiceProvider"
            }
        },
        "google/apiclient-services": [
            "YouTube"
        ]
    },
    "config": {
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true,
            "php-http/discovery": true
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true,
    "repositories": [
        {
            "name": "scribe-mcp",
            "type": "vcs",
            "url": "https://github.com/AleksandrSpicyn/scribe-mcp"
        }
    ]
}
